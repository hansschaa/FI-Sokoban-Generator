#!/bin/bash

CONFIG_ID=$1
INSTANCE_ID=$2
SEED=$3
INSTANCE=$4
shift 4

EXE="../build/irace_generator"
ALGO="ES"
FO="${IRACE_FO:-FO1}"
LAMBDA_SPEED="${IRACE_LAMBDA_SPEED:-0.0}"

# --- SISTEMA DE RASTREO EN TIEMPO REAL ---
# Este archivo guardará el historial de lo que irace ejecuta segundo a segundo
LOG_FILE="ejecuciones_vivas.log"
echo "[$(date '+%Y-%m-%d %H:%M:%S')] 🚀 Probando Config: $CONFIG_ID | Instancia: $INSTANCE | Parámetros: $@" >> $LOG_FILE
# ------------------------------------------

# Ejecutamos redirigiendo stderr a un archivo para no romper el parser de IRace
STDERR_LOG="stderr_irace.log"
OUTPUT=$($EXE $ALGO $FO $SEED $INSTANCE "$@" --heuristic full_surrogate --lambda_speed $LAMBDA_SPEED 2>> $STDERR_LOG)
EXIT_CODE=$?

# --- REGISTRO DEL RESULTADO EN EL LOG ---
if [ $EXIT_CODE -eq 0 ]; then
    echo "    -> ✅ ÉXITO. Fitness devuelto: $OUTPUT" >> $LOG_FILE
else
    echo "    -> 🚨 COLAPSO/ERROR. Código de salida: $EXIT_CODE" >> $LOG_FILE
    echo "    -> Mensaje: $OUTPUT" >> $LOG_FILE
fi
# ----------------------------------------

if [ $EXIT_CODE -ne 0 ]; then
    echo "EL C++ FALLÓ CON EL CÓDIGO: $EXIT_CODE"
    echo "MENSAJE DE ERROR DEL C++:"
    echo "$OUTPUT"
    exit 1
fi

# irace captura exclusivamente esta última línea
echo "$OUTPUT"